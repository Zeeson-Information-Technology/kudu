[Unit]
Description=Kudu Ingestion Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kudu/apps/ingestion
EnvironmentFile=/opt/kudu/apps/ingestion/.env
ExecStart=/usr/bin/node /opt/kudu/apps/ingestion/dist/index.js
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
